# SIGOP — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.

# URL do projeto Supabase (ex: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon) do projeto Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service-role do Supabase (Project Settings > API > service_role).
# SOMENTE servidor — nunca prefixar com NEXT_PUBLIC_. Usada pelos Route Handlers
# de gestão de usuários (app/api/usuarios) para criar/alterar contas de login.
SUPABASE_SERVICE_ROLE_KEY=

# Recuperação de senha por código (e-mail via Resend). SOMENTE servidor.
# API key: https://resend.com/api-keys — o domínio do remetente precisa estar verificado.
RESEND_API_KEY=
# Remetente, ex: SIGOP <nao-responda@seudominio.com.br>
RESEND_FROM=
# Segredo aleatório (>= 32 chars) que assina códigos/tokens. Gere com: openssl rand -base64 48
PASSWORD_RESET_SECRET=
